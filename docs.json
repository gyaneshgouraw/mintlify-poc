{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "My Docs",
  "colors": {
    "primary": "#16A34A"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index", "quickstart", "test"]
          }
        ]
      },
      {
        "tab": "Auth0 spa SDK",
        "sdk": {
          "format": "typedoc",
          "source": "sdk-artifacts/auth0-spa-js.json",
          "directory": "docs/sdk/typescript"
        }
      },
      {
        "tab": "nextjs-auth0 (generated)",
        "sdk": {
          "format": "typedoc",
          "source": "sdk-artifacts/nextjs-auth0.json",
          "directory": "docs/sdk/nextjs"
        }
      },
      {
        "tab": "auth0-server-json (generated)",
        "groups": [
          {
            "group": "Getting Started-mdx-file",
            "pages": ["docs/sdk/auth0-server-json/overview"]
          }
        ],
        "sdk": {
          "format": "typedoc",
          "source": "sdk-artifacts/auth0-server-js.json",
          "directory": "docs/sdk/auth0-server-json"
        }
      },
      {
        "tab": "auth0-server-python (generated)",
        "sdk": {
          "format": "sphinx",
          "source": "sdk-artifacts/auth0-server-python",
          "directory": "docs/sdk/auth0-server-python"
        }
      },
      {
        "tab": "mvc-auth-commons (Java)",
        "sdk": {
          "format": "javadoc",
          "source": "https://repo1.maven.org/maven2/com/auth0/mvc-auth-commons/1.12.0/mvc-auth-commons-1.12.0-javadoc.jar",
          "directory": "docs/sdk/java"
        }
      }
      
    ]
  }
}
